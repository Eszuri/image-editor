<ui:FluentWindow x:Class="ImageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Image Editor"
        Height="720" Width="1040"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Icon="icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Toolbar (Top) -->
            <RowDefinition Height="Auto"/>
            <!-- Image Viewing Area -->
            <RowDefinition Height="*"/>
            <!-- Docked Bottom Crop Bar (Non-floating) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Standard Title Bar -->
        <ui:TitleBar Grid.Row="0" Height="36" Padding="0" Margin="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="icon.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Image Editor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Top Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Open Image" Icon="{ui:SymbolIcon FolderOpen24}" Click="Open_Click" Appearance="Primary" Margin="0,0,8,0"/>
                    <ui:Button x:Name="SaveBtn" Content="Save" Icon="{ui:SymbolIcon Save24}" Click="Save_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <!-- Compress Dropdown Button (Option B) -->
                    <Grid Margin="0,0,12,0">
                        <ui:Button x:Name="CompressBtn" Click="CompressBtn_Click" ToolTip="Image Compression Options">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ResizeImage24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Compress" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <Popup x:Name="CompressMenuPopup"
                               PlacementTarget="{Binding ElementName=CompressBtn}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="4"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Main Menu Border -->
                                <Border x:Name="CompressMainMenuBorder" Background="#202020" BorderBrush="#383838" BorderThickness="1"
                                        CornerRadius="8" Padding="6" Width="260" VerticalAlignment="Top">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Option 1: Compress Current Image (with submenu arrow) -->
                                        <Border x:Name="CompressCurrentItem" Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                MouseDown="CompressCurrentItem_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#303030"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Image24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Compress Current Image" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="Optimize active image on canvas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight16" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="#333333" Margin="4,4"/>

                                        <!-- Option 2: Batch Compress -->
                                        <Border x:Name="BatchCompressItem" Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                MouseDown="BatchCompressItem_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#303030"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Batch Compress Images..." FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="Compress multiple files or folders" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Right Side Submenu (Options on the Right) -->
                                <Border x:Name="CompressSubMenuBorder" Grid.Column="1"
                                        Background="#202020" BorderBrush="#383838" BorderThickness="1"
                                        CornerRadius="8" Padding="6" Width="260" Margin="4,0,0,0"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Submenu Item 1: Compress Edited Image -->
                                        <Border x:Name="CompressEditedItem" Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                MouseDown="CompressEditedItem_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#303030"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Compress Edited Image" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="Active canvas with current edits" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="#333333" Margin="4,4"/>

                                        <!-- Submenu Item 2: Compress Original Image -->
                                        <Border x:Name="CompressOriginalItem" Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                MouseDown="CompressOriginalItem_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#303030"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Document24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Compress Original Image" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="Original unedited source file" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <Border Width="1" Height="20" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,12,0"/>

                    <!-- Undo Button -->
                    <ui:Button x:Name="UndoBtn" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click" IsEnabled="False" Margin="0,0,8,0"/>

                    <!-- Redo Button -->
                    <ui:Button x:Name="RedoBtn" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click" IsEnabled="False" Margin="0,0,8,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomLevelText" Text="" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"/>
                    <TextBlock x:Name="FileNameText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: Left Sidebar + Center Viewport -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsible Left Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0"
                    Width="145"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="6,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Toggle Button (Expand / Collapse) -->
                    <ui:Button x:Name="SidebarToggleBtn" Grid.Row="0"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="8,7"
                               Margin="0,0,0,10"
                               Appearance="Secondary"
                               ToolTip="Toggle Sidebar"
                               Click="SidebarToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="SidebarToggleIcon" Symbol="PanelLeftContract20" FontSize="16"/>
                            <TextBlock x:Name="SidebarToggleText" Text="Tools" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Editing Tools Stack -->
                    <StackPanel Grid.Row="1">
                        <!-- Cursor / Pan Tool -->
                        <ui:Button x:Name="CursorBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="8,7"
                                   Margin="0,0,0,6"
                                   Appearance="Primary"
                                   ToolTip="Cursor / Pan (V)"
                                   Click="Cursor_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Cursor24" FontSize="18"/>
                                <TextBlock x:Name="CursorText" Text="Cursor" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Crop Tool -->
                        <ui:Button x:Name="CropBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="8,7"
                                   Margin="0,0,0,6"
                                   IsEnabled="False"
                                   ToolTip="Crop Image (C)"
                                   Click="Crop_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Crop24" FontSize="18"/>
                                <TextBlock x:Name="CropText" Text="Crop" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Pen Tool with Color Dot -->
                        <ui:Button x:Name="PenBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="8,7"
                                   Margin="0,0,0,6"
                                   IsEnabled="False"
                                   ToolTip="Pen Tool (P)"
                                   Click="Pen_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18">
                                    <ui:SymbolIcon Symbol="Pen24" FontSize="18"/>
                                    <Border x:Name="PenColorIndicator" Width="7" Height="7" CornerRadius="3.5"
                                            Background="#0078D4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            BorderBrush="#202020" BorderThickness="1"/>
                                </Grid>
                                <TextBlock x:Name="PenText" Text="Pen" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Row="2" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="2,6,2,10"/>

                    <!-- Transformation Tools Stack -->
                    <StackPanel Grid.Row="3">
                        <ui:Button x:Name="RotateBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="8,7"
                                   Margin="0,0,0,6"
                                   IsEnabled="False"
                                   ToolTip="Rotate 90° Clockwise"
                                   Click="Rotate_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="18"/>
                                <TextBlock x:Name="RotateText" Text="Rotate 90°" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="FlipBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="8,7"
                                   Margin="0,0,0,6"
                                   IsEnabled="False"
                                   ToolTip="Flip Horizontal"
                                   Click="Flip_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FlipHorizontal24" FontSize="18"/>
                                <TextBlock x:Name="FlipText" Text="Flip" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pen Settings Flyout Popup (Pops out to the right of the sidebar) -->
            <Popup x:Name="PenSettingsPopup"
                   PlacementTarget="{Binding ElementName=PenBtn}"
                   Placement="Right"
                   HorizontalOffset="8"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#202020" BorderBrush="#383838" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,0"
                        Width="290">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Live Pen Preview Card -->
                        <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Brush tip dot preview -->
                                <Border Width="38" Height="38" Background="#0D0D0D" CornerRadius="6" BorderBrush="#242424" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="PenThicknessPreviewDot" Width="3" Height="3" Fill="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Stroke line preview -->
                                <Border Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center" ClipToBounds="True">
                                    <Line x:Name="PenThicknessPreviewLine" X1="0" Y1="19" X2="190" Y2="19"
                                          Stroke="#0078D4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thickness Slider with Numeric Value -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="30" Value="3"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="ThicknessSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThicknessValueText" Grid.Column="1" Text="3 px"
                                       FontWeight="Bold" FontSize="12" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>

                        <!-- 16 Colors Grid (2 rows of 8) -->
                        <!-- Row 1 -->
                        <UniformGrid Rows="1" Columns="8" Margin="0,0,0,6">
                            <Border x:Name="ColorBorder_FFEB3B" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#FFEB3B" Cursor="Hand" Tag="#FFEB3B" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_FFC107" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#FFC107" Cursor="Hand" Tag="#FFC107" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_FF9800" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#FF9800" Cursor="Hand" Tag="#FF9800" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_E53935" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#E53935" Cursor="Hand" Tag="#E53935" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_5E35B1" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#5E35B1" Cursor="Hand" Tag="#5E35B1" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_8E24AA" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#8E24AA" Cursor="Hand" Tag="#8E24AA" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_D81B60" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#D81B60" Cursor="Hand" Tag="#D81B60" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_C2185B" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#C2185B" Cursor="Hand" Tag="#C2185B" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                        </UniformGrid>

                        <!-- Row 2 -->
                        <UniformGrid Rows="1" Columns="8" Margin="0,0,0,12">
                            <Border x:Name="ColorBorder_00B0FF" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#00B0FF" Cursor="Hand" Tag="#00B0FF" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_0078D4" Width="26" Height="26" CornerRadius="13" BorderBrush="#FFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#0078D4" Cursor="Hand" Tag="#0078D4" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_1565C0" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#1565C0" Cursor="Hand" Tag="#1565C0" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_7CB342" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#7CB342" Cursor="Hand" Tag="#7CB342" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_2E7D32" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#2E7D32" Cursor="Hand" Tag="#2E7D32" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_FFFFFF" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" Cursor="Hand" Tag="#FFFFFF" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_9E9E9E" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#9E9E9E" Cursor="Hand" Tag="#9E9E9E" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                            <Border x:Name="ColorBorder_212121" Width="26" Height="26" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#212121" BorderBrush="#55FFFFFF" BorderThickness="1" Cursor="Hand" Tag="#212121" MouseDown="ColorSwatch_MouseDown"/>
                            </Border>
                        </UniformGrid>

                        <!-- Divider -->
                        <Border Height="1" Background="#33FFFFFF" Margin="0,0,0,10"/>

                        <!-- Shape selector row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Freehand (Squiggle) -->
                            <Border x:Name="ShapeFreehandBtn" Width="36" Height="32" CornerRadius="6" Background="#33FFFFFF" Cursor="Hand" Margin="0,0,6,0" MouseDown="ShapeBtn_Click" Tag="Freehand" ToolTip="Freehand">
                                <Path Data="M 10,22 C 14,24 16,18 20,20 C 24,22 26,14 18,12 C 12,10 24,8 26,10"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Straight Line -->
                            <Border x:Name="ShapeLineBtn" Width="36" Height="32" CornerRadius="6" Background="Transparent" Cursor="Hand" Margin="0,0,6,0" MouseDown="ShapeBtn_Click" Tag="Line" ToolTip="Straight Line">
                                <Line X1="8" Y1="24" X2="24" Y2="8" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Single Arrow -->
                            <Border x:Name="ShapeArrowBtn" Width="36" Height="32" CornerRadius="6" Background="Transparent" Cursor="Hand" Margin="0,0,6,0" MouseDown="ShapeBtn_Click" Tag="Arrow" ToolTip="Arrow">
                                <Path Data="M 8,24 L 24,8 M 14,8 L 24,8 L 24,18"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Double Arrow -->
                            <Border x:Name="ShapeDoubleArrowBtn" Width="36" Height="32" CornerRadius="6" Background="Transparent" Cursor="Hand" Margin="0,0,6,0" MouseDown="ShapeBtn_Click" Tag="DoubleArrow" ToolTip="Double Arrow">
                                <Path Data="M 8,24 L 24,8 M 14,8 L 24,8 L 24,18 M 18,24 L 8,24 L 8,14"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Center Image Viewport with Mouse Wheel Zoom & Pan support -->
            <Border Grid.Column="1" Background="#141414" Margin="12,12,16,12" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="ViewportGrid"
                  Background="Transparent"
                  ClipToBounds="True"
                  PreviewMouseWheel="Viewport_PreviewMouseWheel"
                  MouseDown="Viewport_MouseDown"
                  MouseMove="Viewport_MouseMove"
                  MouseUp="Viewport_MouseUp"
                  MouseLeave="Viewport_MouseLeave"
                  SizeChanged="ViewportGrid_SizeChanged">

                <!-- Placeholder when no image -->
                <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ImageAdd24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="No image loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Click 'Open Image' or drag and drop an image here" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ui:Button Content="Choose Image..." Icon="{ui:SymbolIcon FolderOpen24}" Click="Open_Click" Appearance="Primary" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Canvas-based unconstrained viewport (prevents WPF Grid layout clipping!) -->
                <Canvas ClipToBounds="True">
                    <!-- Scalable & Pannable Image + Crop Container -->
                    <Canvas x:Name="ImageContainer"
                            Visibility="Collapsed"
                            RenderTransformOrigin="0,0">

                        <Canvas.RenderTransform>
                            <MatrixTransform x:Name="ImageMatrixTransform"/>
                        </Canvas.RenderTransform>

                        <!-- Loaded Image -->
                        <Image x:Name="DisplayImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Interactive InkCanvas for Pen & Annotation -->
                        <InkCanvas x:Name="MainInkCanvas"
                                   Background="Transparent"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0,0"
                                   PreviewMouseDown="MainInkCanvas_PreviewMouseDown"
                                   PreviewMouseMove="MainInkCanvas_PreviewMouseMove"
                                   PreviewMouseUp="MainInkCanvas_PreviewMouseUp"/>

                        <!-- Shape Preview Canvas (temporary live line/arrow preview) -->
                        <Canvas x:Name="ShapePreviewCanvas"
                                IsHitTestVisible="False"/>

                        <!-- Interactive Crop Canvas (Strictly bounded to image pixels) -->
                        <Canvas x:Name="CropCanvas"
                                Visibility="Collapsed"
                                Background="Transparent"
                                ClipToBounds="False"
                                MouseDown="CropCanvas_MouseDown"
                                MouseMove="CropCanvas_MouseMove"
                                MouseUp="CropCanvas_MouseUp"
                                LostMouseCapture="CropCanvas_LostMouseCapture">

                            <!-- 4 dark masks outside selection -->
                            <Rectangle x:Name="MaskTop" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskBottom" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskLeft" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskRight" Fill="#99000000" IsHitTestVisible="False"/>

                            <!-- Selection border with 3x3 rule of thirds grid -->
                            <Border x:Name="CropBoxBorder"
                                    BorderBrush="#0078D4"
                                    BorderThickness="2"
                                    Background="#01FFFFFF"
                                    IsHitTestVisible="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="GridLineH" Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#80FFFFFF" BorderThickness="0,1,0,1"/>
                                    <Border x:Name="GridLineV" Grid.Column="1" Grid.RowSpan="3" BorderBrush="#80FFFFFF" BorderThickness="1,0,1,0"/>
                                </Grid>
                            </Border>

                            <!-- 4 Corner Handles -->
                            <Border x:Name="HandleTL" Width="14" Height="14" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="3" Cursor="SizeNWSE" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleTR" Width="14" Height="14" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="3" Cursor="SizeNESW" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleBR" Width="14" Height="14" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="3" Cursor="SizeNWSE" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleBL" Width="14" Height="14" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="3" Cursor="SizeNESW" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>

                            <!-- 4 Side Edge Handles (Top, Bottom, Left, Right) -->
                            <Border x:Name="HandleT" Width="28" Height="10" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="4" Cursor="SizeNS" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleB" Width="28" Height="10" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="4" Cursor="SizeNS" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleL" Width="10" Height="28" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="4" Cursor="SizeWE" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                            <Border x:Name="HandleR" Width="10" Height="28" Background="#0078D4" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="4" Cursor="SizeWE" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"/>
                        </Canvas>
                    </Canvas>

                    <!-- Live Pen Cursor Preview Indicator (follows mouse over canvas in Pen mode) -->
                    <Canvas x:Name="PenCursorCanvas" IsHitTestVisible="False">
                        <Grid x:Name="PenCursorPreview" Visibility="Collapsed" IsHitTestVisible="False" Width="3" Height="3">
                            <Ellipse Stroke="#66000000" StrokeThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Ellipse Stroke="#FFFFFFFF" StrokeThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Ellipse x:Name="PenCursorPreviewFill" Fill="#550078D4" Margin="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Rectangle Width="2" Height="2" Fill="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Canvas>
                </Canvas>
            </Grid>
        </Border>
    </Grid>

        <!-- Docked Bottom Crop Action Bar -->
        <Border x:Name="CropBottomBar" Grid.Row="3" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <!-- Left: Realtime pixel crop dimensions & status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Crop24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Crop Size:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CropDimensionsText" Text="0 × 0 px" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CropStatusText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- Right: Action Confirmation -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Click="ApplyCrop_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Click="CancelCrop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compress Image Modal Dialog Overlay -->
        <Grid x:Name="CompressModal" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="#B2000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="460" Background="#202020" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="10" Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.6" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ResizeImage24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Compress Image" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss20}" Appearance="Transparent" HorizontalAlignment="Right" Click="CloseCompressModal_Click" Padding="6" ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- Source Selection Segmented Toggle -->
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="CompressTargetEditedBtn" Grid.Column="0"
                                       Content="Edited Image"
                                       Icon="{ui:SymbolIcon Edit20}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Click="CompressTargetEdited_Click"
                                       ToolTip="Compress image currently on canvas with all edits"/>
                            <ui:Button x:Name="CompressTargetOriginalBtn" Grid.Column="1"
                                       Content="Original Image"
                                       Icon="{ui:SymbolIcon Document20}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Click="CompressTargetOriginal_Click"
                                       Margin="4,0,0,0"
                                       ToolTip="Compress pristine original image without edits"/>
                        </Grid>
                    </Border>

                    <!-- Resolution Info Card -->
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CompressResolutionLabel" Text="Resolution" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="CompressResolutionText" Text="1920 × 1080 px" FontWeight="Bold" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Size Comparison Card -->
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Original Size -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="CompressOriginalSizeLabel" Text="Source Size" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="CompressOriginalSizeText" Text="2.45 MB" FontWeight="Bold" FontSize="14" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Arrow Indicator -->
                            <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight20" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="10,0"/>

                            <!-- Estimated New Size -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Estimated Size" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="CompressReductionText" Text=" (-75%)" FontSize="11" FontWeight="Bold" Foreground="#4CAF50"/>
                                </StackPanel>
                                <TextBlock x:Name="CompressNewSizeText" Text="620 KB" FontWeight="Bold" FontSize="15" Margin="0,3,0,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Compression Size Slider Section -->
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Compression Size" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompressQualityValueText" Text="80%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Grid>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Minus RepeatButton -->
                            <RepeatButton x:Name="CompressMinusBtn" Grid.Column="0"
                                          Width="28" Height="28"
                                          Delay="300" Interval="50"
                                          Click="CompressMinus_Click"
                                          ToolTip="Decrease by 1% (Hold to repeat)"
                                          Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="BtnBorder" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                                            <ui:SymbolIcon Symbol="Subtract16" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#353535"/>
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A4A4A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#1A1A1A"/>
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <!-- Slider -->
                            <Slider x:Name="CompressQualitySlider" Grid.Column="1"
                                    Margin="8,0"
                                    Minimum="10" Maximum="100" Value="80"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="CompressQualitySlider_ValueChanged"
                                    VerticalAlignment="Center"/>

                            <!-- Plus RepeatButton -->
                            <RepeatButton x:Name="CompressPlusBtn" Grid.Column="2"
                                          Width="28" Height="28"
                                          Delay="300" Interval="50"
                                          Click="CompressPlus_Click"
                                          ToolTip="Increase by 1% (Hold to repeat)"
                                          Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="BtnBorder" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                                            <ui:SymbolIcon Symbol="Add16" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#353535"/>
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A4A4A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#1A1A1A"/>
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </StackPanel>

                    <!-- Modal Action Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="Cancel" HorizontalAlignment="Left" Click="CloseCompressModal_Click" Appearance="Secondary"/>
                        <ui:Button Grid.Column="1" Content="Save Compressed Image..." Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="SaveCompressed_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Batch Compress Modal Dialog Overlay -->
        <Grid x:Name="BatchCompressModal" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="#B2000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="840" MaxHeight="660" Background="#202020" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="10" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.6" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Queue Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Queue List Box -->
                        <RowDefinition Height="*"/>
                        <!-- 3: Options Card (Settings + Destination) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Progress Bar & Action Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Batch Compress Images" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss20}" Appearance="Transparent" HorizontalAlignment="Right" Click="CloseBatchCompressModal_Click" Padding="6" ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- Row 1: Queue Actions Toolbar -->
                    <Border Grid.Row="1" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Add Files..." Icon="{ui:SymbolIcon DocumentAdd24}" Click="BatchAddFiles_Click" Appearance="Secondary" Margin="0,0,8,0" Padding="10,5"/>
                                <ui:Button Content="Add Folder..." Icon="{ui:SymbolIcon FolderAdd24}" Click="BatchAddFolder_Click" Appearance="Secondary" Margin="0,0,8,0" Padding="10,5"/>
                                <ui:Button x:Name="BatchClearBtn" Content="Clear List" Icon="{ui:SymbolIcon Delete24}" Click="BatchClearQueue_Click" Appearance="Transparent" Margin="0,0,8,0" Padding="10,5"/>
                            </StackPanel>
                            <TextBlock x:Name="BatchQueueSummaryText" Text="0 files (0 B)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Queue List Box with Drag and Drop -->
                    <Border Grid.Row="2" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" MinHeight="170" MaxHeight="220"
                            AllowDrop="True" Drop="BatchQueue_Drop" DragOver="BatchQueue_DragOver">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel x:Name="BatchEmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <ui:SymbolIcon Symbol="ImageAdd24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag and drop images or folders here" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="or click 'Add Files...' or 'Add Folder...' above (JPG, PNG, WEBP, BMP)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Items ListView -->
                            <ListView x:Name="BatchListView" Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#242424" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File Name + ToolTip -->
                                                <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                                                <!-- Dimensions -->
                                                <TextBlock Grid.Column="1" Text="{Binding ResolutionFormatted}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>

                                                <!-- Original Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding OriginalSizeFormatted}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>

                                                <!-- Arrow -->
                                                <ui:SymbolIcon Grid.Column="3" Symbol="ArrowRight16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                                                <!-- New Size + Reduction -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NewSizeFormatted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ReductionFormatted, StringFormat=' ({0})'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="4" Background="#1E1E1E">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>

                                                <!-- Remove button -->
                                                <ui:Button Grid.Column="6" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Padding="4" Click="BatchRemoveItem_Click" Tag="{Binding}" ToolTip="Remove from list"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Row 3: Compression Settings & Output Destination Card -->
                    <Grid Grid.Row="3" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Compression Mode Card -->
                        <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Compression Mode" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                                <!-- Mode 1: Quality Slider -->
                                <RadioButton x:Name="BatchModeSliderRadio" GroupName="BatchModeGroup" Content="Quality Slider" FontWeight="SemiBold" IsChecked="True" Checked="BatchMode_Changed" Margin="0,0,0,4"/>
                                <StackPanel x:Name="BatchSliderControls" Margin="20,0,0,8">
                                    <Grid Margin="0,2,0,4">
                                        <TextBlock Text="Quality:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="BatchSliderValueText" Text="80%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="11"/>
                                    </Grid>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RepeatButton x:Name="BatchSliderMinusBtn" Grid.Column="0" Width="24" Height="24" Delay="300" Interval="50" Click="BatchSliderMinus_Click" Cursor="Hand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                                                        <ui:SymbolIcon Symbol="Subtract16" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                        <Slider x:Name="BatchQualitySlider" Grid.Column="1" Margin="6,0" Minimum="10" Maximum="100" Value="80" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="BatchQualitySlider_ValueChanged"/>
                                        <RepeatButton x:Name="BatchSliderPlusBtn" Grid.Column="2" Width="24" Height="24" Delay="300" Interval="50" Click="BatchSliderPlus_Click" Cursor="Hand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                                                        <ui:SymbolIcon Symbol="Add16" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Grid>
                                </StackPanel>

                                <!-- Mode 2: Target File Size -->
                                <RadioButton x:Name="BatchModeTargetSizeRadio" GroupName="BatchModeGroup" Content="Target File Size (Max)" FontWeight="SemiBold" Checked="BatchMode_Changed" Margin="0,0,0,4"/>
                                <StackPanel x:Name="BatchTargetSizeControls" Margin="20,0,0,8" Visibility="Collapsed">
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Max Size:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBox x:Name="BatchTargetSizeInput" Grid.Column="1" Text="500" Margin="0,0,6,0" Padding="6,3" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                                        <ComboBox x:Name="BatchTargetSizeUnit" Grid.Column="2" SelectedIndex="0" Padding="6,3">
                                            <ComboBoxItem Content="KB"/>
                                            <ComboBoxItem Content="MB"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="BatchSkipSmallerCheck" Content="Skip images already smaller than target" IsChecked="True" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Mode 3: Percentage of Original Size -->
                                <RadioButton x:Name="BatchModePercentageRadio" GroupName="BatchModeGroup" Content="Target % of Original Size" FontWeight="SemiBold" Checked="BatchMode_Changed" Margin="0,0,0,2"/>
                                <StackPanel x:Name="BatchPercentageControls" Margin="20,0,0,0" Visibility="Collapsed">
                                    <Grid Margin="0,2,0,4">
                                        <TextBlock Text="Target Size Ratio:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="BatchPercentageValueText" Text="50%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="BatchPercentageSlider" Minimum="10" Maximum="90" Value="50" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="BatchPercentageSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: Output Destination Card -->
                        <Border Grid.Column="1" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Output Destination" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                                <RadioButton x:Name="BatchDestSubfolderRadio" GroupName="BatchDestGroup" Content="Subfolder in original directory" FontWeight="SemiBold" IsChecked="True" Margin="0,0,0,4"/>
                                <StackPanel Margin="20,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Subfolder name:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBox x:Name="BatchSubfolderNameInput" Grid.Column="1" Text="_compressed" Padding="6,3" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <RadioButton x:Name="BatchDestCustomRadio" GroupName="BatchDestGroup" Content="Save to custom folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Margin="20,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="BatchCustomFolderInput" Grid.Column="0" IsReadOnly="True" PlaceholderText="Select output folder..." Margin="0,0,6,0" Padding="6,3" VerticalContentAlignment="Center"/>
                                        <ui:Button Grid.Column="1" Content="Browse..." Click="BatchBrowseCustomFolder_Click" Padding="8,3"/>
                                    </Grid>
                                </StackPanel>

                                <RadioButton x:Name="BatchDestOverwriteRadio" GroupName="BatchDestGroup" Content="Overwrite original files (Warning)" FontWeight="SemiBold" Foreground="#FFA726" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Progress Bar & Footer Actions -->
                    <StackPanel Grid.Row="4" Margin="0,4,0,0">
                        <!-- Progress Bar & Status Text -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="BatchProgressStatusText" Text="Ready to compress" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BatchProgressPercentText" Text="" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="BatchProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Background="#252525"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Content="Close" Click="CloseBatchCompressModal_Click" Appearance="Secondary" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BatchOpenFolderBtn" Content="Open Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="BatchOpenFolder_Click" Appearance="Secondary" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <ui:Button x:Name="BatchCancelBtn" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Click="BatchCancel_Click" Appearance="Danger" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <ui:Button x:Name="BatchStartBtn" Content="Start Compression" Icon="{ui:SymbolIcon Play24}" Click="BatchStart_Click" Appearance="Primary"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Replace / Open Image Confirmation Modal Overlay -->
        <Grid x:Name="ReplaceConfirmModal" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="#B2000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="460" Background="#202020" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="10" Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.6" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="#FFA726" Margin="0,0,10,0"/>
                            <TextBlock Text="Unsaved Changes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss20}" Appearance="Transparent" HorizontalAlignment="Right" Click="CloseReplaceConfirmModal_Click" Padding="6" ToolTip="Cancel (Esc)"/>
                    </Grid>

                    <!-- Explanatory message -->
                    <TextBlock x:Name="ReplaceConfirmMessageText"
                               Text="You have unsaved edits on the current image. Opening a new image will discard your progress."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Compact File Pill -->
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Document20" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ReplaceConfirmNewFileNameText" Grid.Column="1" Text="image.png" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons Footer -->
                    <Grid>
                        <ui:Button Content="Cancel" Appearance="Secondary" HorizontalAlignment="Left" Click="CloseReplaceConfirmModal_Click" Padding="14,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Open in New Window" Icon="{ui:SymbolIcon WindowNew24}" Appearance="Secondary" Click="ReplaceConfirmNewWindow_Click" Margin="0,0,8,0" Padding="12,6"/>
                            <ui:Button Content="Replace" Icon="{ui:SymbolIcon ArrowSwap24}" Appearance="Danger" Click="ReplaceConfirmReplace_Click" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
